DISCORD_API_TOKEN=INSERT_YOUR_DISCORD_API_TOKEN_HERE

# Default prefix is '-'
DISCORD_BOT_PREFIX=-

# Optional Netscape cookie input. The bot does not rewrite this export.
# Leave empty for anonymous YouTube access.
# Use the same commands with or without cookies: uv sync --locked; uv run bot.
# Keep the file outside the repository and cloud-synced folders.
# Example: C:/Users/YOUR_NAME/AppData/Local/Crummy/youtube.cookies.txt
YTDLP_COOKIES_FILE=

# Optional FFmpeg executable name or full path.
FFMPEG_EXECUTABLE=ffmpeg

# Local per-server prefixes (not tokens). Use persistent storage on a host.
CRUMMY_DATA_DIR=data

# Concurrent extraction processes across all servers. Requests within one server
# remain FIFO, with one extraction at a time (including stream refreshes).
WORKERS=3

# Concurrent FFmpeg startup / first-frame checks; NOT the number of songs that
# may keep playing. Each server can continue its own playback independently.
AUDIO_WORKERS=2

# Accepted preparation requests, including the active request.
REQUESTS=12
GUILD_REQUESTS=3

# Playlist entries per request and songs per server's playback queue.
PLAYLIST_LIMIT=50
QUEUE_LIMIT=200

# Seconds. Extraction includes waiting for an extraction worker, but excludes
# waiting behind earlier requests from the same server.
EXTRACT_TIMEOUT=60
CONNECT_TIMEOUT=30
STREAM_MAX_AGE=120
